{
  "manifest_version": 3,
  "name": "新人研修",
  "version": "0.1.0",
  "description": "業務Webシステムの画面上で操作手順を案内する新人教育用ガイド",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "css": [
        "lib/driver.js/driver.css",
        "styles/popover.css"
      ],
      "js": [
        "lib/driver.js/driver.js.iife.js",
        "site/config.js",
        "content/url-match.js",
        "content/schema.js",
        "content/element-resolver.js",
        "content/practice-guard.js",
        "content/advance-watcher.js",
        "content/progress-store.js",
        "content/tour-repository.js",
        "content/highlighter.js",
        "content/navigation-watcher.js",
        "content/tour-engine.js",
        "content/url-watcher.js",
        "content/panel.js",
        "content/main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/panel.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
